# Copy this file to application.properties (or set these as real environment
# variables) and fill in real values. application.properties is gitignored on
# purpose and must never be committed with real secrets.

spring.datasource.url=jdbc:postgresql://<host>/<database>?sslmode=require
spring.datasource.username=<db-username>
spring.datasource.password=<db-password>

spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Generate with: openssl rand -hex 32
jwt.secret=<random-hex-secret>

admin.inicial.username=admin
admin.inicial.password=<initial-admin-password>
